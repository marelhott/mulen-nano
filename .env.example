OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_HTTP_REFERER=https://mulen-nano.vercel.app
OPENROUTER_X_TITLE=Mulen Nano
# Volitelné obrazové služby, pouze při explicitní volbě jejich modelu.
VENICE_API_KEY=
VITE_SUPABASE_URL=https://poregdcgfwokxgmhpvac.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Databanka (Cloudflare R2). Přístup k R2 sdílí s API pro LoRA/modely; bucket je soukromý.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
BANK_BUCKET=bank
# Dlouhé heslo k Databance (min. ~20 znaků) a náhodné tajemství pro podpis přihlašovacích tokenů.
BANK_PASSPHRASE=
BANK_TOKEN_SECRET=

# /api/r2-presign (LoRA/modely) vyžaduje stejný přihlašovací token jako Databanka,
# tedy BANK_PASSPHRASE a BANK_TOKEN_SECRET výše. Bez BANK_TOKEN_SECRET endpoint odpovídá 503.
R2_ALLOWED_BUCKETS=loras,models
# Povolené předpony klíčů po bucketech (bucket bez záznamu nemá omezení). Výchozí: loras:loras/
R2_ALLOWED_KEY_PREFIXES=loras:loras/
# PUT odkazy jsou ve výchozím stavu vypnuté (aplikace je nepoužívá); zapnutí: true
R2_PRESIGN_ALLOW_PUT=false
